---
import '../global.css';
import { SITE } from '../site';
const group = Array.from({ length: 6 }, () => SITE.ticker).flat();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = `${SITE.name} — концепт сайта мини-автосалона`;
---
<!doctype html>
<html lang="ru" data-mode="plate">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={SITE.description} />
  <meta name="theme-color" content="#07080b" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={SITE.description} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;600&family=Unbounded:wght@800;900&family=Playfair+Display:ital,wght@1,500&display=swap" rel="stylesheet" />
</head>
<body class="text-white antialiased">
  <canvas id="gl" class="pointer-events-none fixed inset-0 z-0 h-full w-full"></canvas>

  <nav class="glass fixed left-1/2 top-4 z-30 flex -translate-x-1/2 items-center gap-1 rounded-full p-1.5 text-sm">
    <a href="#top" class="px-4 py-2 font-head text-xs">{SITE.name}</a>
    <div class="flex rounded-full bg-white/10 p-0.5 text-xs font-semibold" role="group" aria-label="Режим">
      <button type="button" data-m="plate" class="mode-btn rounded-full px-3 py-1.5">Знак</button>
      <button type="button" data-m="car" class="mode-btn rounded-full px-3 py-1.5">Додж</button>
    </div>
    <a class="hidden rounded-full px-4 py-2 transition hover:bg-white/10 sm:block" href="#svc">Услуги</a>
    <a class="hidden rounded-full px-4 py-2 transition hover:bg-white/10 sm:block" href="#contacts">Контакты</a>
    <a class="rounded-full bg-accent px-5 py-2 font-semibold text-black" href={`tel:${SITE.tel}`}>Позвонить</a>
  </nav>

  <main class="relative z-10">
    <section id="top" class="flex min-h-svh flex-col justify-end pb-14 pt-28">
      <div class="px-5 sm:px-10">
        <p class="glass mb-5 w-fit rounded-full px-4 py-2 text-sm">Концепт сайта для проекта Владимира Братишкина</p>
        <h1 class="font-head text-[clamp(4.2rem,25vw,24rem)] font-black leading-[.8] tracking-tighter">ТАЧКИ</h1>
        <p class="mt-2 font-serif text-[clamp(2.2rem,9vw,7rem)] italic leading-none text-accent"><span class="only-plate">под ваш номер</span><span class="only-car">которые едут</span></p>
      </div>
      <div class="marquee"><div class="track"><div class="grp">{group.map((t) => <span>{t} /</span>)}</div><div class="grp" aria-hidden="true">{group.map((t) => <span>{t} /</span>)}</div></div></div>
    </section>

    <section class="flex min-h-[85svh] items-end px-5 pb-16 sm:px-10">
      <div class="glass only-plate relative w-full max-w-md rounded-3xl p-6">
        <p class="mb-3 font-head text-sm">Соберите свой номер</p>
        <div class="flex items-start gap-2">
          <label class="block w-14"><input id="pl-l1" maxlength="1" autocomplete="off" placeholder="А" class="fld" /><span class="cap">буква</span></label>
          <label class="block w-24"><input id="pl-d" maxlength="3" inputmode="numeric" autocomplete="off" placeholder="777" class="fld" /><span class="cap">цифры</span></label>
          <label class="block w-20"><input id="pl-l2" maxlength="2" autocomplete="off" placeholder="АА" class="fld" /><span class="cap">буквы</span></label>
          <label class="block w-20"><input id="pl-r" maxlength="3" inputmode="numeric" autocomplete="off" placeholder="77" class="fld" /><span class="cap">регион</span></label>
        </div>
        <p id="pl-hint" class="mt-3 text-sm text-white/60">Буквы только А В Е К М Н О Р С Т У Х. Регион: 2 цифры (01–99) или 3 (1xx, 7xx).</p>
        <a href={SITE.telegram} class="mt-5 block rounded-full bg-accent py-3 text-center font-semibold text-black">Написать в Telegram</a>
      </div>
      <div class="glass only-car w-full max-w-md rounded-3xl p-6">
        <p class="mb-2 font-head text-sm">Dodge Challenger SRT Hellcat</p>
        <p class="text-sm text-white/70">Хотите такой? Подберём под ваш бюджет и привезём.</p>
        <a href={SITE.telegram} class="mt-5 block rounded-full bg-accent py-3 text-center font-semibold text-black">Написать в Telegram</a>
      </div>
    </section>

    <section id="svc" class="px-5 py-24 sm:px-10">
      <h2 class="mb-10 font-head text-[clamp(2.4rem,9vw,8rem)] font-black leading-[.9] tracking-tighter">Чем <span class="font-serif font-medium italic text-accent">занимаемся</span></h2>
      <div class="grid gap-4 md:grid-cols-3 md:grid-rows-2">
        {SITE.services.map((s, i) => (
          <article class={`glass relative rounded-[2rem] p-7 ${i === 0 ? 'md:col-span-2 md:row-span-2 md:p-12' : ''}`}>
            <h3 class={`font-head font-black ${i === 0 ? 'text-4xl md:text-6xl' : 'text-2xl'}`}>{s.title}{s.soon && <span class="ml-3 inline-block -rotate-6 rounded-md border-2 border-accent px-2 py-0.5 align-middle font-head text-xs text-accent">скоро</span>}</h3>
            <p class={`mt-4 text-white/75 ${i === 0 ? 'max-w-lg text-xl' : ''}`}>{s.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="px-5 py-32 sm:px-10">
      <p id="words" class="max-w-5xl font-head text-[clamp(1.8rem,6vw,4.6rem)] font-black leading-[1.08] tracking-tight">Подберём автомобиль, привезём, проверим и оформим все документы. Вам останется забрать ключи.</p>
    </section>

    <section id="contacts" class="px-5 pb-24 pt-10 sm:px-10">
      <div class="glass relative rounded-[2rem] p-8 md:p-14">
        <h2 class="font-head text-xl">Связаться</h2>
        <a href={`tel:${SITE.tel}`} class="my-6 block font-head text-[clamp(1.8rem,8vw,6rem)] font-black leading-none">{SITE.phone}</a>
        <p>Telegram: {SITE.telegram}</p>
        <p class="mt-3">Адрес: {SITE.address}</p>
      </div>
      <p class="mt-8 text-sm text-white/50">© {new Date().getFullYear()} {SITE.name}. {SITE.disclaimer}</p>
    </section>
  </main>

  <button class="up glass fixed bottom-4 right-4 z-30 h-12 w-12 rounded-full text-xl" aria-label="Наверх">↑</button>
  <script>import '../scripts/main.ts';</script>
</body>
</html>
